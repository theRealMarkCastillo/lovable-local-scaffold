FRONTEND_KIND=tanstack
# Documentation only: make init generates fresh local secrets from upstream defaults.
# Port 8090 avoids the separate local-cloud-demo on 8080.
STACK_NAME=lovable-local
PUBLIC_URL=http://localhost:8090
WEB_PORT=8090
ADMIN_PORT=19800
MAIL_PORT=18025
# Local email confirmation is enabled. Messages stay in Mailpit.
# Real social login/payment/AI integrations are not configured by this template.
